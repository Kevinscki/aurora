[Unit]
Description=Aurora desktop assistant
Documentation=file:///home/kelvin/Downloads/aurora/electron/README.md
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/home/kelvin/Downloads/aurora/electron
ExecStart=/home/kelvin/Downloads/aurora/electron/node_modules/electron/dist/electron . --no-sandbox --ozone-platform=x11
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=10
Environment=AURORA_SERVICE=1

[Install]
WantedBy=graphical-session.target
