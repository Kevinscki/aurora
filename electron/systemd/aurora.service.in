# Generated from this template by install.sh. Do not install the template directly.
[Unit]
Description=Aurora desktop assistant
After=graphical-session.target
PartOf=graphical-session.target
ConditionPathExists="@ELECTRON_BIN@"

[Service]
Type=simple
WorkingDirectory="@ELECTRON_DIR@"
ExecStart="@ELECTRON_BIN@" "." "--no-sandbox" "--ozone-platform=x11"
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=10
Environment=AURORA_SERVICE=1

[Install]
WantedBy=graphical-session.target
